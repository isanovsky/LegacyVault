# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env TIDAK di-commit (sudah ada di .gitignore). File .env.example ini aman di-commit
# karena tidak berisi rahasia.
#
# Forge membaca file .env secara otomatis saat menjalankan `forge script`.

# ---------------------------------------------------------------------------
# Konfigurasi vault (dipakai script/Deploy.s.sol)
# ---------------------------------------------------------------------------
# Nilai di bawah memakai akun bawaan Anvil 1-5, cocok untuk `npm run deploy-local`.
# Untuk Sepolia WAJIB diganti dengan alamat sungguhan. Skrip akan menolak deploy
# di luar Anvil jika masih ada alamat akun Anvil, karena private key-nya publik.

# Ahli waris, dipisah koma tanpa spasi.
HEIRS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# Porsi tiap ahli waris dalam basis point, urutan sama dengan HEIRS. Total harus 10000.
SHARES_BPS=6000,4000
# Guardian, dipisah koma tanpa spasi. Tidak boleh sama dengan ahli waris.
GUARDIANS=0x90F79bf6EB2c4f870365E785982E1f101E93b906,0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65,0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
# Jumlah persetujuan guardian minimal.
THRESHOLD=2
# Masa tidak aktif dalam detik. 15552000 = 180 hari. Minimal 86400 (1 hari), maksimal 315360000 (3650 hari).
INACTIVITY_PERIOD=15552000
# Masa tunggu setelah persetujuan cukup, dalam detik. 604800 = 7 hari. Minimal 86400, maksimal 315360000.
TIMELOCK_PERIOD=604800
# Setoran awal saat deploy, dalam wei (opsional). 0 = tanpa setoran.
INITIAL_DEPOSIT_WEI=0

# ---------------------------------------------------------------------------
# Khusus Sepolia (tidak dipakai di Anvil)
# ---------------------------------------------------------------------------
# URL RPC Sepolia dari penyedia seperti Alchemy atau Infura.
SEPOLIA_RPC_URL=
# Private key wallet KHUSUS TESTNET (jangan wallet yang berisi aset sungguhan), diawali 0x.
PRIVATE_KEY=
# API key Etherscan untuk verifikasi kontrak.
ETHERSCAN_API_KEY=
